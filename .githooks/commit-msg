#!/bin/sh

PATTERN='^FEN-[0-9]+: (feat|fix|chore|docs|style|refactor|test|perf|ci|build|revert)\([a-zA-Z0-9_/-]+\): .+$'
MSG=$(cat "$1")

if ! echo "$MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "❌ Invalid commit message format."
  echo "   Required: FEN-<number>: <type>(<scope>): <description>"
  echo "   Example:  FEN-12: feat(auth): add login endpoint"
  echo ""
  echo "   Types: feat|fix|chore|docs|style|refactor|test|perf|ci|build|revert"
  echo ""
  exit 1
fi
